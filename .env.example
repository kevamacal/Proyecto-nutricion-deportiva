# Environment & Server Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# Database & Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
